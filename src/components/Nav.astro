---
import { getLang, localizePath, ui } from "../i18n/ui";

const lang = getLang(Astro.url.pathname);
const t = ui[lang];
const otherLang = lang === "he" ? "en" : "he";

const links = [
  { href: localizePath("/", lang), label: t.nav.home },
  { href: localizePath("/product-design", lang), label: t.nav.productDesign },
  { href: localizePath("/curatorial", lang), label: t.nav.curatorial },
  { href: localizePath("/about", lang), label: t.nav.about },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" || href === "/en" ? path === href : path.startsWith(href);

const otherLangHref = localizePath(path, otherLang);
const brandName = lang === "en" ? "Lital Bar Noy" : "ליטל בר נוי";
---

<header
  class="sticky top-0 z-50 w-full bg-cream/85 backdrop-blur-sm border-b border-line"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 lg:px-10">
    <a
      href={localizePath("/", lang)}
      class="font-display text-lg font-bold tracking-tight"
      data-cursor-hover
    >
      {brandName}
    </a>
    <ul class="hidden items-center gap-8 md:flex">
      {
        links.slice(1).map((link) => (
          <li>
            <a
              href={link.href}
              data-cursor-hover
              class:list={[
                "link-underline text-sm font-medium transition-colors duration-300",
                isActive(link.href) ? "text-ink" : "text-ink-soft",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={otherLangHref}
          data-cursor-hover
          class="link-underline text-sm font-medium text-ink-soft"
        >
          {otherLang === "en" ? "EN" : "עברית"}
        </a>
      </li>
    </ul>
    <button
      id="nav-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label={lang === "en" ? "Open menu" : "פתיחת תפריט"}
      aria-expanded="false"
    >
      <span class="block h-px w-6 bg-ink"></span>
      <span class="block h-px w-6 bg-ink"></span>
    </button>
  </nav>
  <ul
    id="nav-mobile"
    class="hidden flex-col gap-1 border-t border-line px-6 pb-4 md:hidden"
  >
    {
      links.slice(1).map((link) => (
        <li>
          <a href={link.href} class="block py-3 text-sm font-medium">
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href={otherLangHref} class="block py-3 text-sm font-medium text-ink-soft">
        {otherLang === "en" ? "EN" : "עברית"}
      </a>
    </li>
  </ul>
</header>

<script>
  function setupMobileNav() {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-mobile");
    if (!toggle || !menu || toggle.dataset.bound) return;
    toggle.dataset.bound = "true";
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
      menu.classList.toggle("flex");
    });
  }
  setupMobileNav();
  document.addEventListener("astro:page-load", setupMobileNav);
</script>
