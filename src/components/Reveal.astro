---
// Markup-only wrapper. All motion is owned by MotionLayer.astro:
// text tags opt into a masked per-line reveal via `data-split`, everything
// else gets the plain block reveal. Both are fail-safe — with no JS the
// element renders in its final, readable state (see global.css).
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
  split?: boolean;
}

const { as: Tag = "div", class: className, split } = Astro.props;

const TEXT_TAGS = ["h1", "h2", "h3", "h4", "p"];
const useSplit = split ?? TEXT_TAGS.includes(Tag);
---

{
  useSplit ? (
    <Tag class={className} data-split>
      <slot />
    </Tag>
  ) : (
    <Tag class:list={["reveal", className]}>
      <slot />
    </Tag>
  )
}
