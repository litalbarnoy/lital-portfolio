---
// The soft-body gummy bear that sits behind the hero.
//
// Mounts only where WebGPU exists. Everywhere else nothing loads at all —
// not the module, not the 1.2 MB model — and the page keeps the CSS
// ColorField gradient it already had, which is the designed fallback.
---

<div id="gummy-layer" aria-hidden="true">
  <!-- The bear's touch target. `touch-action` only governs the element that
       actually receives a gesture, and the canvas is pointer-events:none, so
       the rule on it never applied and mobile browsers claimed every touch as a
       scroll. This pad tracks the body's real screen box and declares
       touch-action:none, so a finger landing on the bear reaches the drag
       handler instead of being taken for a swipe. It covers only the body, so
       the rest of the page still scrolls normally. -->
  <div id="gummy-grab"></div>
</div>

<style is:global>
  /* Above the headline, below the cards. z-index 1 clears the page's normal
     flow (which is auto), and the card section is lifted to 2. Site landmarks
     sit far above: nav 50, page transition 1000, cursor 9999. */
  /* ABSOLUTE, not fixed. Fixed pinned the bear to the viewport, so it travelled
     down the page with the reader and sat over the work cards. Anchored to the
     document instead, it keeps its place in the hero and scrolls away like any
     other element — which also lets the IntersectionObserver park the render
     loop the moment it leaves the screen. */
  #gummy-layer {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 100vh;
    /* svh = the SMALL viewport height, i.e. with the mobile browser's toolbar
       showing. Plain vh is the large viewport, so on a phone the layer is
       taller than what is actually visible and its height changes as the URL
       bar collapses — which resizes the canvas mid-scroll. Falls back to the
       vh above wherever svh is unsupported. */
    block-size: 100svh;
    /* The grab pad tracks the bear's box, and the bear is framed hard against
       one edge — so its box can start a few pixels off-screen. The canvas does
       not care, but the pad is a real element and those few pixels became real
       horizontal page scroll. Clipping the layer contains it; the canvas is
       exactly the layer's size, so nothing visible is cut. */
    overflow: hidden;
    z-index: 1;
    /* Click-through. The canvas covers the whole viewport, so owning pointer
       events would swallow every link on the page; the bear does its own hit
       test on window instead and only takes the gesture when it is really hit. */
    pointer-events: none;
  }

  #gummy-layer canvas {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    /* A plain vertical swipe still scrolls; GrabControl only claims the
       gesture after a deliberate hold. */
    touch-action: pan-y;
  }

  #gummy-grab {
    position: absolute;
    left: var(--gummy-box-left, 50%);
    top: var(--gummy-box-top, 50%);
    inline-size: var(--gummy-box-width, 0);
    block-size: var(--gummy-box-height, 0);
    pointer-events: auto;
    /* The whole point: this element owns the gesture, so the browser does not
       hand it to the scroller and cancel the pointer stream mid-drag. */
    touch-action: none;
  }

  /* No "not yet reported" guard is needed: until hero.js publishes a box the
     width and height fall back to 0, so there is nothing to hit anyway. An
     earlier :not([style]) guard matched permanently — the pad is positioned
     from custom properties, never from an inline style attribute — and left
     the pad inert. */

  /* Cards read on top of the bear. */
  body.gummy-active [data-gummy-blocks] {
    position: relative;
    z-index: 2;
  }

  /* The CSS gradient stays. The canvas is transparent now and the glass
     refracts an analytic copy of this same gradient, so the page keeps
     painting its own background and the two agree. */

  @media (prefers-reduced-motion: reduce) {
    #gummy-layer {
      display: none;
    }
  }
</style>

<script>
  let hero: { destroy(): void } | null = null;

  async function mount() {
    if (hero) return;
    const el = document.getElementById("gummy-layer");
    if (!el) return;

    // Gate before importing: this keeps three.js out of the bundle that
    // browsers without WebGPU ever have to download.
    if (!navigator.gpu) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    try {
      const { mountGummyHero } = await import("./gummy/hero.js");
      hero = await mountGummyHero(el, { preset: "amber" });
      // Dev-only handle for tuning from the console. Stripped from production
      // builds by the import.meta.env.DEV branch.
      if (import.meta.env.DEV) (window as any).__gummy = hero;
    } catch (err) {
      console.warn("[gummy] could not start, falling back to the gradient", err);
      hero = null;
    }
  }

  function unmount() {
    hero?.destroy();
    hero = null;
  }

  document.addEventListener("astro:page-load", mount);
  // View transitions swap the DOM without a reload; without this the GPU
  // context and its buffers would leak on every navigation.
  document.addEventListener("astro:before-swap", unmount);
  window.addEventListener("pagehide", unmount);
</script>
