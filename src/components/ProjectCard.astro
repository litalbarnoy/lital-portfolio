---
import HoverDistortImage from "./HoverDistortImage.astro";

interface Props {
  href: string;
  title: string;
  subtitle: string;
  cover: string;
  image2?: string;
  year: number;
}

const { href, title, subtitle, cover, image2, year } = Astro.props;
---

<a href={href} class="reveal group block" data-cursor-hover>
  <div class="relative overflow-hidden rounded-sm bg-line">
    <HoverDistortImage
      image1={cover}
      image2={image2}
      alt={title}
      class="aspect-[16/10] w-full"
    />
    <div
      class="pointer-events-none absolute inset-0 flex items-end bg-gradient-to-t from-ink/60 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    >
      <span class="p-6 font-bold text-lg text-cream">{title}</span>
    </div>
  </div>
  <div class="mt-4 flex items-baseline justify-between">
    <h3 class="text-xl font-semibold">{title}</h3>
    <span class="text-sm text-ink-soft">{year}</span>
  </div>
  <p class="mt-1 text-ink-soft">{subtitle}</p>
</a>
