---
---

<canvas id="ripple-canvas" class="ripple-canvas" aria-hidden="true"></canvas>

<style>
  .ripple-canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    transition: opacity 0.3s var(--ease-expo);
  }
  .ripple-canvas.is-active {
    opacity: 1;
  }
  .ripple-text-el {
    transition: opacity 0.3s var(--ease-expo);
  }
  .ripple-text-hidden {
    opacity: 0;
  }
</style>

<script>
  import * as THREE from "three";
  import gsap from "gsap";

  type RippleSource = HTMLImageElement | HTMLCanvasElement;

  const VERTEX_SHADER = `
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  const FRAGMENT_SHADER = `
    uniform sampler2D uTexture;
    uniform vec2 uMouse;
    uniform float uVelocity;
    uniform float uHover;
    varying vec2 vUv;

    void main() {
      vec2 uv = vUv;
      float dist = distance(uv, uMouse);
      float falloff = 1.0 - smoothstep(0.0, 0.4, dist);
      vec2 delta = uv - uMouse;
      vec2 dir = length(delta) > 0.0001 ? normalize(delta) : vec2(0.0);
      float amount = falloff * clamp(uVelocity, 0.0, 3.0) * uHover * 0.07;

      vec2 uvR = clamp(uv + dir * amount * 1.5, 0.0, 1.0);
      vec2 uvG = clamp(uv + dir * amount, 0.0, 1.0);
      vec2 uvB = clamp(uv + dir * amount * 0.5, 0.0, 1.0);

      float r = texture2D(uTexture, uvR).r;
      float g = texture2D(uTexture, uvG).g;
      float b = texture2D(uTexture, uvB).b;
      float a = texture2D(uTexture, uv).a;

      gl_FragColor = vec4(r, g, b, a);
    }
  `;

  // Renders an element's text to a canvas so it can be used as a WebGL
  // texture. Uses the pre-split .hero-line-inner spans when present
  // (exact match for the hero heading); otherwise falls back to a
  // generic greedy word-wrap that approximates the element's own
  // line breaks closely enough for a hover-only effect.
  function buildTextTexture(el: HTMLElement): HTMLCanvasElement {
    const rect = el.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio, 2);
    const off = document.createElement("canvas");
    off.width = Math.max(1, Math.round(rect.width * dpr));
    off.height = Math.max(1, Math.round(rect.height * dpr));
    const ctx = off.getContext("2d")!;
    ctx.scale(dpr, dpr);

    const isRtl = getComputedStyle(el).direction === "rtl";
    ctx.direction = isRtl ? "rtl" : "ltr";
    ctx.textAlign = isRtl ? "right" : "left";
    ctx.textBaseline = "alphabetic";

    const heroLines = el.querySelectorAll<HTMLElement>(".hero-line-inner");
    if (heroLines.length) {
      heroLines.forEach((line) => {
        const lineRect = line.getBoundingClientRect();
        const style = getComputedStyle(line);
        ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
        ctx.fillStyle = style.color;
        const x = isRtl ? lineRect.right - rect.left : lineRect.left - rect.left;
        const y = lineRect.top - rect.top + lineRect.height * 0.78;
        ctx.fillText(line.textContent || "", x, y);
      });
      return off;
    }

    const style = getComputedStyle(el);
    const fontSize = parseFloat(style.fontSize) || 16;
    const lineHeight = parseFloat(style.lineHeight) || fontSize * 1.4;
    ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    ctx.fillStyle = style.color;

    const paddingLeft = parseFloat(style.paddingLeft) || 0;
    const paddingRight = parseFloat(style.paddingRight) || 0;
    const maxWidth = rect.width - paddingLeft - paddingRight;
    const x = isRtl ? rect.width - paddingRight : paddingLeft;

    const words = (el.textContent || "").trim().split(/\s+/).filter(Boolean);
    let line = "";
    let y = paddingLeft >= 0 ? lineHeight * 0.75 : lineHeight * 0.75;
    for (const word of words) {
      const test = line ? `${line} ${word}` : word;
      if (line && ctx.measureText(test).width > maxWidth) {
        ctx.fillText(line, x, y);
        line = word;
        y += lineHeight;
      } else {
        line = test;
      }
    }
    if (line) ctx.fillText(line, x, y);

    return off;
  }

  function createEngine(canvas: HTMLCanvasElement) {
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      preserveDrawingBuffer: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-0.5, 0.5, 0.5, -0.5, 0.1, 10);
    camera.position.z = 1;

    const texture = new THREE.Texture();
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.wrapS = THREE.ClampToEdgeWrapping;
    texture.wrapT = THREE.ClampToEdgeWrapping;
    texture.minFilter = THREE.LinearFilter;
    texture.magFilter = THREE.LinearFilter;
    const material = new THREE.ShaderMaterial({
      uniforms: {
        uTexture: { value: texture },
        uMouse: { value: new THREE.Vector2(0.5, 0.5) },
        uVelocity: { value: 0 },
        uHover: { value: 0 },
      },
      vertexShader: VERTEX_SHADER,
      fragmentShader: FRAGMENT_SHADER,
      transparent: true,
    });
    const mesh = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), material);
    scene.add(mesh);

    const state = { hover: 0, velocity: 0 };
    let activeRect: DOMRect | null = null;
    let lastX = 0;
    let lastY = 0;
    let rafId = 0;
    let isRunning = false;

    function render() {
      state.velocity *= 0.9;
      material.uniforms.uVelocity.value = state.velocity;
      material.uniforms.uHover.value = state.hover;
      renderer.render(scene, camera);

      if (state.hover > 0.001 || state.velocity > 0.001) {
        rafId = requestAnimationFrame(render);
      } else {
        isRunning = false;
      }
    }

    function ensureRunning() {
      if (isRunning) return;
      isRunning = true;
      rafId = requestAnimationFrame(render);
    }

    function attachTo(source: RippleSource, rect: DOMRect) {
      activeRect = rect;
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;
      canvas.style.transform = `translate(${rect.left + window.scrollX}px, ${
        rect.top + window.scrollY
      }px)`;
      renderer.setSize(rect.width, rect.height, false);

      const texture = material.uniforms.uTexture.value as THREE.Texture;
      texture.image = source;
      texture.needsUpdate = true;

      canvas.classList.add("is-active");
      ensureRunning();
      gsap.to(state, { hover: 1, duration: 0.5, ease: "power2.out" });
    }

    function detach() {
      ensureRunning();
      gsap.to(state, {
        hover: 0,
        duration: 0.5,
        ease: "power2.out",
        onComplete: () => {
          canvas.classList.remove("is-active");
          activeRect = null;
        },
      });
    }

    function bindMouseTracking(container: HTMLElement, getSource: () => RippleSource) {
      container.addEventListener("mouseenter", () => {
        lastX = -1;
        lastY = -1;
        attachTo(getSource(), container.getBoundingClientRect());
      });

      container.addEventListener("mousemove", (e: MouseEvent) => {
        if (!activeRect) return;
        const x = (e.clientX - activeRect.left) / activeRect.width;
        const y = 1 - (e.clientY - activeRect.top) / activeRect.height;
        material.uniforms.uMouse.value.set(x, y);
        if (lastX >= 0) {
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          state.velocity = Math.min(Math.sqrt(dx * dx + dy * dy) * 0.15, 3);
        }
        lastX = e.clientX;
        lastY = e.clientY;
      });
    }

    function dispose() {
      cancelAnimationFrame(rafId);
      isRunning = false;
      const currentTexture = material.uniforms.uTexture.value as THREE.Texture;
      currentTexture?.dispose();
      material.dispose();
      mesh.geometry.dispose();
      renderer.dispose();
    }

    return { canvas, bindMouseTracking, detach, dispose };
  }

  function bindPageElements(engine: ReturnType<typeof createEngine>) {
    document.querySelectorAll<HTMLImageElement>("[data-ripple] img").forEach((img) => {
      const container = img.closest<HTMLElement>("[data-ripple]");
      if (!container || container.dataset.rippleBound) return;
      container.dataset.rippleBound = "true";

      engine.bindMouseTracking(container, () => img);
      container.addEventListener("mouseleave", engine.detach);
    });

    document
      .querySelectorAll<HTMLElement>("[data-ripple-text], .prose-project p")
      .forEach((el) => {
        if (el.dataset.rippleBound) return;
        el.dataset.rippleBound = "true";
        el.classList.add("ripple-text-el");

        engine.bindMouseTracking(el, () => buildTextTexture(el));
        el.addEventListener("mouseenter", () => el.classList.add("ripple-text-hidden"));
        el.addEventListener("mouseleave", () => {
          el.classList.remove("ripple-text-hidden");
          engine.detach();
        });
      });
  }

  function setupRippleField() {
    const isDesktopPointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)"
    ).matches;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (!isDesktopPointer || prefersReducedMotion) return;

    let engine = (window as any).__rippleEngine;

    // Client-side navigation swaps in a brand new <canvas> element even
    // though this script's top-level state persists; a WebGL context
    // bound to the old (now-detached) canvas silently stops rendering
    // correctly, so recreate the engine whenever that happens.
    if (engine && !engine.canvas.isConnected) {
      engine.dispose();
      engine = null;
    }

    if (!engine) {
      const canvas = document.getElementById("ripple-canvas") as HTMLCanvasElement;
      if (!canvas) return;
      engine = createEngine(canvas);
      (window as any).__rippleEngine = engine;
    }

    // Element binding must re-run on every page load (client-side
    // navigation swaps in new DOM elements that need fresh listeners),
    // even though the WebGL engine itself is only created once.
    bindPageElements(engine);
  }

  setupRippleField();
  document.addEventListener("astro:page-load", setupRippleField);
</script>
