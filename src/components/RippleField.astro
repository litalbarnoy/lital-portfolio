---
// Pointer-driven displacement with per-channel RGB dispersion, rendered on a
// single persistent WebGL canvas (OGL). The canvas is parked over whichever
// [data-ripple] element the pointer is inside; every uniform lerps back to
// zero so the resting state is always the untouched DOM underneath.
---

<canvas id="ripple-canvas" class="ripple-canvas" aria-hidden="true"></canvas>

<style>
  .ripple-canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    transition: opacity 0.3s var(--ease-expo);
  }
  .ripple-canvas.is-active {
    opacity: 1;
  }
</style>

<script>
  import { Renderer, Program, Mesh, Triangle, Texture } from "ogl";

  type RippleSource = HTMLImageElement | HTMLCanvasElement;
  type EffectMode = "ripple" | "loupe";

  const VERTEX = `
    attribute vec2 position;
    attribute vec2 uv;
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  // Displacement falls off with distance from the pointer and scales with
  // pointer speed; the three channels are offset by different amounts to
  // produce the chromatic fringe on the leading edge.
  const FRAGMENT = `
    precision highp float;
    uniform sampler2D uTexture;
    uniform vec2 uMouse;
    uniform vec2 uResolution;
    uniform vec2 uImageSize;
    uniform float uVelocity;
    uniform float uHover;
    uniform float uLoupe;
    uniform float uZoom;
    uniform float uRadius;
    varying vec2 vUv;

    // The quad matches the element's box, but the texture keeps the image's
    // own aspect ratio. Without this the shader would stretch the image to
    // the box and the WebGL copy would be cropped differently from the
    // object-fit:cover DOM image underneath it.
    vec2 coverUv(vec2 uv) {
      if (uImageSize.x <= 0.0 || uImageSize.y <= 0.0) return uv;
      float boxRatio = uResolution.x / uResolution.y;
      float imgRatio = uImageSize.x / uImageSize.y;
      vec2 scaled = boxRatio < imgRatio
        ? vec2(uImageSize.x * uResolution.y / uImageSize.y, uResolution.y)
        : vec2(uResolution.x, uImageSize.y * uResolution.x / uImageSize.x);
      vec2 offset = (boxRatio < imgRatio
        ? vec2((scaled.x - uResolution.x) * 0.5, 0.0)
        : vec2(0.0, (scaled.y - uResolution.y) * 0.5)) / scaled;
      return uv * uResolution / scaled + offset;
    }

    void main() {
      vec2 uv = vUv;

      // Measure distance in pixels, not uv, or the lens comes out an
      // ellipse on any element that is not square.
      vec2 px = vec2(uResolution.x / uResolution.y, 1.0);
      float lensDist = distance(uv * px, uMouse * px);

      // --- magnifier -------------------------------------------------
      // Pull the sample point toward the cursor: the closer the sampled
      // texel is dragged, the larger that part of the image is drawn.
      float edge = smoothstep(uRadius, uRadius * 0.88, lensDist);
      float lens = edge * uLoupe * uHover;
      vec2 magnified = uMouse + (uv - uMouse) / uZoom;
      vec2 lensUv = mix(uv, magnified, lens);

      // A touch of refraction right at the rim, so the circle reads as a
      // piece of glass sitting on the image rather than a cut-out.
      float rim = smoothstep(uRadius * 0.82, uRadius, lensDist)
                * smoothstep(uRadius * 1.02, uRadius * 0.94, lensDist);
      vec2 outward = lensDist > 0.0001
        ? normalize((uv - uMouse) * px) / px
        : vec2(0.0);
      lensUv += outward * rim * 0.012 * uLoupe * uHover;

      // --- pointer-speed dispersion ----------------------------------
      float falloff = 1.0 - smoothstep(0.0, 0.4, distance(uv, uMouse));
      vec2 delta = uv - uMouse;
      vec2 dir = length(delta) > 0.0001 ? normalize(delta) : vec2(0.0);
      float amount = falloff * clamp(uVelocity, 0.0, 3.0) * uHover * 0.07
                   * (1.0 - uLoupe);

      // Split the channels by a hair inside the lens as well — real glass
      // disperses, and it keeps the magnified edge from looking printed.
      float split = amount + rim * 0.004 * uLoupe * uHover;

      vec2 uvR = coverUv(clamp(lensUv + dir * split * 1.5, 0.0, 1.0));
      vec2 uvG = coverUv(clamp(lensUv + dir * split, 0.0, 1.0));
      vec2 uvB = coverUv(clamp(lensUv + dir * split * 0.5, 0.0, 1.0));

      float r = texture2D(uTexture, uvR).r;
      float g = texture2D(uTexture, uvG).g;
      float b = texture2D(uTexture, uvB).b;
      float a = texture2D(uTexture, coverUv(lensUv)).a;

      // Hairline ring, and a slight lift inside, so the lens has an edge
      // without drawing a hard border over the design underneath.
      vec3 color = vec3(r, g, b);
      color += vec3(0.06) * rim * uLoupe * uHover;
      color += vec3(0.02) * lens;

      gl_FragColor = vec4(color, a);
    }
  `;

  // Roughly 130px across whatever the element's size, clamped so it never
  // swallows a small card or turns into a dot on a full-width hero.
  function lensRadius(rect: DOMRect): number {
    const shortest = Math.min(rect.width, rect.height);
    const px = Math.max(90, Math.min(150, shortest * 0.28));
    return px / rect.height;
  }

  function createEngine(canvas: HTMLCanvasElement) {
    const renderer = new Renderer({
      canvas,
      alpha: true,
      dpr: Math.min(window.devicePixelRatio, 2),
    });
    const gl = renderer.gl;

    const texture = new Texture(gl, { generateMipmaps: false });
    const program = new Program(gl, {
      vertex: VERTEX,
      fragment: FRAGMENT,
      transparent: true,
      uniforms: {
        uTexture: { value: texture },
        uMouse: { value: [0.5, 0.5] },
        uResolution: { value: [1, 1] },
        uImageSize: { value: [0, 0] },
        uVelocity: { value: 0 },
        uHover: { value: 0 },
        uLoupe: { value: 0 },
        uZoom: { value: 2.6 },
        uRadius: { value: 0.17 },
      },
    });
    const mesh = new Mesh(gl, { geometry: new Triangle(gl), program });

    const state = { hover: 0, hoverTarget: 0, velocity: 0, velocityTarget: 0 };
    let activeEl: HTMLElement | null = null;
    let activeRect: DOMRect | null = null;
    let sizedW = 0;
    let sizedH = 0;
    let lastX = -1;
    let lastY = -1;
    let rafId = 0;
    let running = false;

    // The canvas is position:fixed and lives outside the hovered element,
    // so it is not clipped by that element's overflow and does not move
    // with the page. Re-anchoring it to the live rect every frame is what
    // keeps it from stranding mid-viewport during a scroll — which
    // otherwise paints a frozen second copy of the content.
    function syncToActive() {
      if (!activeEl) return;
      const rect = activeEl.getBoundingClientRect();
      activeRect = rect;
      canvas.style.transform = `translate(${rect.left}px, ${rect.top}px)`;

      if (rect.width !== sizedW || rect.height !== sizedH) {
        sizedW = rect.width;
        sizedH = rect.height;
        renderer.setSize(rect.width, rect.height);
        program.uniforms.uResolution.value[0] = rect.width;
        program.uniforms.uResolution.value[1] = rect.height;
        program.uniforms.uRadius.value = lensRadius(rect);
      }

      if (lastX >= 0) {
        // Keep the sample point under the pointer as the element moves.
        program.uniforms.uMouse.value[0] = (lastX - rect.left) / rect.width;
        program.uniforms.uMouse.value[1] =
          1 - (lastY - rect.top) / rect.height;

        // Scrolling can carry the element out from under a stationary
        // pointer without ever firing mouseleave.
        const outside =
          lastX < rect.left ||
          lastX > rect.right ||
          lastY < rect.top ||
          lastY > rect.bottom;
        if (outside) detach();
      }
    }

    function render() {
      syncToActive();

      // Everything lerps toward zero and hard-snaps below a threshold, so
      // the effect can never be left part-way applied. Velocity is lerped
      // rather than assigned so a fast pointer jump ramps in and trails
      // out instead of snapping to full displacement in one frame.
      state.hover += (state.hoverTarget - state.hover) * 0.12;
      state.velocityTarget *= 0.9;
      state.velocity += (state.velocityTarget - state.velocity) * 0.1;
      if (state.velocity < 0.001) state.velocity = 0;
      if (state.velocityTarget < 0.001) state.velocityTarget = 0;
      if (Math.abs(state.hoverTarget - state.hover) < 0.001) {
        state.hover = state.hoverTarget;
      }

      program.uniforms.uVelocity.value = state.velocity;
      program.uniforms.uHover.value = state.hover;
      renderer.render({ scene: mesh });

      if (state.hover > 0.001 || state.velocity > 0.001) {
        rafId = requestAnimationFrame(render);
      } else {
        running = false;
        canvas.classList.remove("is-active");
        activeEl = null;
        activeRect = null;
      }
    }

    function ensureRunning() {
      if (running) return;
      running = true;
      rafId = requestAnimationFrame(render);
    }

    function attachTo(
      el: HTMLElement,
      source: RippleSource | null,
      mode: EffectMode
    ) {
      if (!source) return;
      activeEl = el;
      program.uniforms.uLoupe.value = mode === "loupe" ? 1 : 0;

      const rect = el.getBoundingClientRect();
      activeRect = rect;
      sizedW = rect.width;
      sizedH = rect.height;
      // position:fixed, so getBoundingClientRect()'s viewport-relative
      // coordinates are already correct; syncToActive() keeps them current.
      canvas.style.transform = `translate(${rect.left}px, ${rect.top}px)`;
      renderer.setSize(rect.width, rect.height);
      program.uniforms.uResolution.value[0] = rect.width;
      program.uniforms.uResolution.value[1] = rect.height;
      program.uniforms.uRadius.value = lensRadius(rect);

      // Intrinsic pixel size, so the shader can reproduce object-fit:cover.
      const img = source as HTMLImageElement;
      program.uniforms.uImageSize.value[0] = img.naturalWidth || source.width;
      program.uniforms.uImageSize.value[1] = img.naturalHeight || source.height;

      texture.image = source;
      texture.needsUpdate = true;

      canvas.classList.add("is-active");
      state.hoverTarget = 1;
      ensureRunning();
    }

    function detach() {
      state.hoverTarget = 0;
      ensureRunning();
    }

    function bind(
      container: HTMLElement,
      getSource: () => RippleSource | null,
      mode: EffectMode = "ripple"
    ) {
      container.addEventListener("mouseenter", (e: MouseEvent) => {
        lastX = e.clientX;
        lastY = e.clientY;
        attachTo(container, getSource(), mode);
      });

      container.addEventListener("mousemove", (e: MouseEvent) => {
        if (!activeRect) return;
        program.uniforms.uMouse.value[0] =
          (e.clientX - activeRect.left) / activeRect.width;
        program.uniforms.uMouse.value[1] =
          1 - (e.clientY - activeRect.top) / activeRect.height;
        if (lastX >= 0) {
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          state.velocityTarget = Math.min(
            Math.sqrt(dx * dx + dy * dy) * 0.15,
            3
          );
        }
        lastX = e.clientX;
        lastY = e.clientY;
      });
    }

    function reset() {
      state.hover = 0;
      state.hoverTarget = 0;
      state.velocity = 0;
      state.velocityTarget = 0;
      activeEl = null;
      activeRect = null;
      lastX = -1;
      lastY = -1;
      program.uniforms.uHover.value = 0;
      program.uniforms.uVelocity.value = 0;
      canvas.classList.remove("is-active");
    }

    function dispose() {
      cancelAnimationFrame(rafId);
      running = false;
      const ext = gl.getExtension("WEBGL_lose_context");
      ext?.loseContext();
    }

    return { canvas, bind, detach, reset, dispose };
  }

  type Engine = ReturnType<typeof createEngine>;

  function bindPageElements(engine: Engine) {
    document.querySelectorAll<HTMLImageElement>("[data-ripple] img").forEach((img) => {
      const container = img.closest<HTMLElement>("[data-ripple]");
      if (!container || container.dataset.rippleBound) return;
      container.dataset.rippleBound = "true";

      // Track the image's own box, not the wrapper's. A contained screenshot
      // sits inset inside its padded frame, and anchoring to the wrapper put
      // the effect 32px off centre and at the wrong size.
      const mode = container.dataset.ripple === "loupe" ? "loupe" : "ripple";
      engine.bind(img, () => img, mode);
      img.addEventListener("mouseleave", engine.detach);
    });

    // Text is deliberately not distorted. Painting DOM text into a canvas
    // and swapping the real text out cannot be kept in register with the
    // live layout, and any drift reads as doubled or floating glyphs. Doing
    // it properly needs a real DOM->bitmap snapshot pipeline; until that
    // exists, headings stay untouched DOM text.
  }

  function setup() {
    // The whole layer is optional: skip it entirely where it would be
    // wasted or unwelcome, and the plain DOM is what remains.
    const isDesktopPointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)"
    ).matches;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    // Skip narrow viewports — but only on a positive reading. innerWidth can
    // report 0 before layout settles, and treating that as "narrow" silently
    // disabled the whole layer. Touch devices are already excluded above.
    const width = window.innerWidth || document.documentElement.clientWidth || 0;
    const isNarrow = width > 0 && width < 768;
    if (!isDesktopPointer || prefersReducedMotion || isNarrow) {
      return;
    }

    let engine: Engine | undefined = (window as any).__rippleEngine;

    // A client-side navigation swaps in a fresh <canvas> even though this
    // module's state persists; a context bound to the detached canvas stops
    // rendering, so rebuild the engine when that happens.
    if (engine && !engine.canvas.isConnected) {
      engine.dispose();
      engine = undefined;
    }

    if (!engine) {
      const canvas = document.getElementById("ripple-canvas") as HTMLCanvasElement | null;
      if (!canvas) return;
      try {
        engine = createEngine(canvas);
      } catch (err) {
        // The DOM underneath is already the fallback, but staying silent
        // here once hid a real setup failure — say something.
        console.warn("[ripple] WebGL layer disabled:", err);
        return;
      }
      (window as any).__rippleEngine = engine;
    }

    // Element binding re-runs on every page load; the engine is built once.
    bindPageElements(engine);

    if (!(window as any).__rippleGlobalsBound) {
      (window as any).__rippleGlobalsBound = true;
      const active = () => (window as any).__rippleEngine as Engine | undefined;

      // Scrolling moves the element out from under the pointer, and the
      // canvas is a fixed-position sibling that nothing clips. Clearing it
      // synchronously here — rather than waiting for the animation loop to
      // fade it out — is what guarantees no stranded copy is left painted
      // over the page, even when rAF is throttled or suspended.
      window.addEventListener("scroll", () => active()?.reset(), {
        passive: true,
      });

      // A hidden tab suspends rAF entirely; without this the effect would
      // be frozen mid-hover and still visible on return.
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) active()?.reset();
      });
    }
  }

  setup();
  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", () => {
    (window as any).__rippleEngine?.reset();
  });
</script>
