---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import { getLang, ui } from "../i18n/ui";
import { formatYear } from "../lib/formatYear";
import { paletteAttrs } from "../lib/palette";
import { youtubeEmbed } from "../lib/youtube";
import { parseSections } from "../lib/projectContent";
import { imageSize } from "../lib/imageSize";
import { resolveGallery, type MediaEntry } from "../lib/media";
import LottieFigure from "../components/LottieFigure.astro";
import Lightbox from "../components/Lightbox.astro";

interface Props {
  title: string;
  subtitle: string;
  role: string;
  client: string;
  year: number;
  yearEnd?: number;
  ongoing?: boolean;
  tags: string[];
  cover: string;
  gallery: MediaEntry[];
  video?: string;
  coverAnimation?: { src: string; width: number; height: number };
  animations?: { src: string; caption?: string; width: number; height: number }[];
  body: string;
  externalUrl?: string;
  next?: { href: string; title: string; cover?: string } | null;
}

const {
  title,
  subtitle,
  role,
  client,
  year,
  yearEnd,
  ongoing,
  tags,
  cover,
  gallery,
  video,
  coverAnimation,
  animations,
  body,
  externalUrl,
  next,
} = Astro.props;

const lang = getLang(Astro.url.pathname);
const t = ui[lang].project;

// UI screenshots are shown whole on a neutral surface; cropping them to fill
// a frame turns them into unreadable fragments. Photography fills.
const isUi = Astro.url.pathname.includes("/product-design/");

// The same field holds a different kind of thing in each section: an employer
// in product design, the space an exhibition was held in, an academic
// institution. One label cannot be right for all three — and "client" was
// wrong for every one of them, since none of this was freelance work.
const contextLabel = Astro.url.pathname.includes("/curatorial/")
  ? t.venue
  : Astro.url.pathname.includes("/academic/")
    ? t.institution
    : t.company;
const fit: "contain" | "cover" = isUi ? "contain" : "cover";

// The header takes the colour of the section the project belongs to.
const headerPalette = isUi ? "work" : "curatorial";

const texts = parseSections(body);
const intro = texts[0] ?? null;
const rest = texts.slice(1);

// Every reel card gets its own width and baseline. A strip of identically
// sized rectangles is what makes a short gallery read as generic; the varied
// rhythm plus the oversized type behind it is what carries the section when
// there are only three or four images to show.
const CARD_WIDTHS = ["is-w-lg", "is-w-sm", "is-w-md", "is-w-xs", "is-w-lg"];
const CARD_OFFSETS = ["is-drop-0", "is-drop-2", "is-drop-1", "is-drop-3", "is-drop-1"];

const media = resolveGallery(gallery, title);

const sizes = new Map<string, { width: number; height: number }>();
for (const src of [cover, ...media.map((m) => m.src), ...(next?.cover ? [next.cover] : [])]) {
  sizes.set(src, await imageSize(src));
}

// Each arrow is drawn pointing the way it travels, rather than mirrored with
// a transform — which would leave a permanent scaleX(-1) sitting in the page.
const CHEVRON_LEFT = "M15 5l-7 7 7 7";
const CHEVRON_RIGHT = "M9 5l7 7-7 7";
const rtl = lang === "he";
const arrowStart = rtl ? CHEVRON_RIGHT : CHEVRON_LEFT;
const arrowEnd = rtl ? CHEVRON_LEFT : CHEVRON_RIGHT;

const videoEmbed = video ? youtubeEmbed(video) : null;
const coverSize = sizes.get(cover)!;
---

<BaseLayout title={title} description={subtitle} palette={headerPalette}>
  <article class="project">
    {/* 01 — header: oversized title beside the cover, which carries the
        same pointer-driven hover as the rest of the site. */}
    <header class="project-hero container" {...paletteAttrs(headerPalette)}>
      <div class="hero-text">
        <p class="label reveal">{role}</p>
        <h1 class="project-title" data-hero-title>{title}</h1>

        <div class="hero-foot reveal">
          <p class="project-subtitle">{subtitle}</p>

          <ul class="tag-pills">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>

          <dl class="meta-row">
            <div>
              <dt class="label">{contextLabel}</dt>
              <dd>{client}</dd>
            </div>
            <div>
              <dt class="label">{t.year}</dt>
              <dd>{formatYear({ year, yearEnd, ongoing }, lang)}</dd>
            </div>
            {
              externalUrl && (
                <div>
                  <dt class="label">{t.link}</dt>
                  <dd>
                    <a href={externalUrl} target="_blank" rel="noopener" class="link-underline">
                      {new URL(externalUrl).hostname}
                    </a>
                  </dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>

      {
        coverAnimation ? (
          // The animation is the header. It carries no loupe: the WebGL layer
          // textures an image, and this is live vector — the motion is the
          // point here rather than the magnifier.
          <div class="hero-media hero-media-animated" data-media>
            <LottieFigure
              src={coverAnimation.src}
              width={coverAnimation.width}
              height={coverAnimation.height}
              label={title}
            />
          </div>
        ) : (
          /* Parallax needs object-fit: cover, which would crop a UI screenshot
             into an unreadable fragment — so photography gets the drift and
             screenshots get shown whole instead. A contained cover also drops
             the fixed 3:2 box: a near-square screenshot letterboxed inside it
             read as a large empty frame with a small picture in the middle. */
          <figure
            class:list={[
              "hero-media",
              "media-frame",
              `fit-${fit}`,
              fit === "contain" && coverSize.transparent && "has-plate",
            ]}
            style={
              fit === "contain"
                ? `aspect-ratio:${coverSize.width} / ${coverSize.height}`
                : undefined
            }
            data-ripple="loupe"
            data-media
            data-parallax={fit === "cover" ? "" : undefined}
          >
            <Image
              src={cover}
              width={coverSize.width}
              height={coverSize.height}
              alt={title}
              widths={[600, 900, 1200, 1600]}
              sizes="(max-width: 900px) 100vw, 45vw"
            />
          </figure>
        )
      }
    </header>

    {
      intro && (
        <section class="project-section container text-section" {...paletteAttrs("about")}>
          <h2 class="section-label" data-split>{intro.label}</h2>
          <div class="section-body reveal" set:html={intro.html} />
        </section>
      )
    }

    {/* 02 — the one gallery: a horizontal reel, dragged or stepped with the
        arrows, riding over the project name at display size. */}
    {
      media.length > 0 && (
        <section class="reel" aria-roledescription="carousel" aria-label={title} {...paletteAttrs(headerPalette)}>
          <div class="reel-type" data-horizontal aria-hidden="true">
            <span>{title}</span>
          </div>

          <div class="reel-track" data-reel-track tabindex="0">
            {media.map(({ src, caption, alt }, i) => (
              <figure
                class:list={[
                  "reel-card",
                  CARD_WIDTHS[i % CARD_WIDTHS.length],
                  CARD_OFFSETS[i % CARD_OFFSETS.length],
                ]}
              >
                {/* A contained screenshot keeps its own proportions — forcing
                    it into a decorative portrait frame just surrounds it with
                    empty surface. Photography is cropped anyway, so it takes
                    the varied frame that gives the reel its rhythm.
                    The inset plate is only for art that is actually cut out:
                    a solid screenshot has its own edges and needs no ground. */}
                <button
                  type="button"
                  class:list={[
                    "media-frame",
                    `fit-${fit}`,
                    fit === "contain" && sizes.get(src)!.transparent && "has-plate",
                  ]}
                  style={
                    fit === "contain"
                      ? `aspect-ratio:${sizes.get(src)!.width} / ${sizes.get(src)!.height}`
                      : undefined
                  }
                  data-ripple="loupe"
                  data-media
                  data-lightbox-open={src}
                  data-lightbox-alt={alt}
                  data-lightbox-caption={caption ?? ""}
                >
                  {src.endsWith(".gif") ? (
                    <img
                      src={src}
                      alt={alt}
                      loading="lazy"
                      width={sizes.get(src)!.width}
                      height={sizes.get(src)!.height}
                    />
                  ) : (
                    <Image
                      src={src}
                      width={sizes.get(src)!.width}
                      height={sizes.get(src)!.height}
                      alt={alt}
                      widths={[400, 800, 1200, 1600]}
                      sizes="(max-width: 900px) 78vw, 50vw"
                    />
                  )}
                </button>
                {caption && <figcaption class="reel-caption">{caption}</figcaption>}
              </figure>
            ))}
          </div>

          <div class="reel-controls container">
            {/* The images open full size on click, which nothing else on the
                page announces. Stated once, quietly, opposite the arrows. */}
            <p class="reel-hint">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5M11 8.5v5M8.5 11h5" />
              </svg>
              {t.enlargeHint}
            </p>
            <div class="reel-buttons">
            <button type="button" class="reel-btn" data-reel-prev aria-label={t.prev}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowStart} /></svg>
            </button>
            <button type="button" class="reel-btn" data-reel-next aria-label={t.nextImage}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowEnd} /></svg>
            </button>
            </div>
          </div>
        </section>
      )
    }

    {
      animations && animations.length > 0 && (
        <section class="project-section container animation-grid" {...paletteAttrs("about")}>
          {animations.map((a) => (
            <LottieFigure
              src={a.src}
              caption={a.caption}
              width={a.width}
              height={a.height}
              label={title}
            />
          ))}
        </section>
      )
    }

    {
      rest.map((section) => (
        <section class="project-section container text-section" {...paletteAttrs("about")}>
          <h2 class="section-label" data-split>{section.label}</h2>
          <div class="section-body reveal" set:html={section.html} />
        </section>
      ))
    }

    {
      videoEmbed && (
        <section class="project-section container">
          <div class="video-frame" data-media>
            <iframe
              src={videoEmbed}
              title={title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          </div>
        </section>
      )
    }

    {
      next && (
        <a class="next-project" href={next.href} {...paletteAttrs("contact")} data-cursor-hover data-astro-prefetch="hover">
          <span class="label">{t.next}</span>
          <span class="next-title">{next.title}</span>
          {next.cover && (
            <span class="next-thumb" aria-hidden="true">
              <Image
                src={next.cover}
                width={sizes.get(next.cover)!.width}
                height={sizes.get(next.cover)!.height}
                alt=""
                widths={[400, 800]}
                sizes="18vw"
              />
            </span>
          )}
        </a>
      )
    }
  </article>

  <Lightbox />
</BaseLayout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // The track is a real horizontal scroll container, so dragging, swiping,
  // the keyboard and a no-JS load all work on their own. The arrows only
  // step it — they are an addition, never the only way through.
  function buildReel() {
    const track = document.querySelector<HTMLElement>("[data-reel-track]");
    if (!track || track.dataset.reelBound) return;
    track.dataset.reelBound = "true";

    const prev = document.querySelector<HTMLElement>("[data-reel-prev]");
    const next = document.querySelector<HTMLElement>("[data-reel-next]");

    // In RTL the inline axis runs the other way, and scrollLeft counts down
    // from zero, so every step has to be signed by the writing direction.
    const sign = () => (document.dir === "rtl" ? -1 : 1);

    const step = () => {
      const card = track.querySelector<HTMLElement>(".reel-card");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (card?.getBoundingClientRect().width ?? track.clientWidth * 0.6) + gap;
    };

    const go = (dir: 1 | -1) =>
      track.scrollBy({ left: step() * dir * sign(), behavior: "smooth" });

    prev?.addEventListener("click", () => go(-1));
    next?.addEventListener("click", () => go(1));

    // Arrows that can never do anything are worse than no arrows, so a reel
    // whose images already fit hides them entirely rather than showing two
    // permanently dead buttons.
    const controls = document.querySelector<HTMLElement>(".reel-controls");
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      controls?.toggleAttribute("hidden", max <= 1);
      const pos = Math.abs(track.scrollLeft);
      prev?.toggleAttribute("disabled", pos <= 1);
      next?.toggleAttribute("disabled", pos >= max - 1);
    };
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync, { passive: true });
    sync();
  }

  // The project name drifts behind the reel — the only scrubbed thing in the
  // section, decorative, aria-hidden, and clipped by its own wrapper.
  function buildReelType() {
    const band = document.querySelector<HTMLElement>(".reel-type");
    const inner = band?.querySelector<HTMLElement>("span");
    if (!band || !inner || band.dataset.typeBound) return;
    band.dataset.typeBound = "true";

    const mm = gsap.matchMedia();
    mm.add("(min-width: 768px) and (prefers-reduced-motion: no-preference)", () => {
      const dir = document.dir === "rtl" ? 1 : -1;
      const tween = gsap.fromTo(
        inner,
        { xPercent: -6 * dir },
        {
          xPercent: 6 * dir,
          ease: "none",
          scrollTrigger: {
            trigger: band,
            start: "top bottom",
            end: "bottom top",
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        }
      );
      return () => tween.kill();
    });
  }

  // The hero title reveals on load, not on scroll — it is already on screen.
  function revealHeroTitle() {
    const el = document.querySelector<HTMLElement>("[data-hero-title]");
    if (!el || el.dataset.heroRevealed) return;
    el.dataset.heroRevealed = "true";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const inner = document.createElement("span");
    inner.className = "hero-title-inner";
    while (el.firstChild) inner.appendChild(el.firstChild);
    const mask = document.createElement("span");
    mask.className = "hero-title-mask";
    mask.appendChild(inner);
    el.appendChild(mask);

    gsap.fromTo(
      inner,
      { yPercent: 100 },
      { yPercent: 0, duration: 0.9, ease: "expo.out", delay: 0.1, clearProps: "transform" }
    );
  }

  function init() {
    revealHeroTitle();
    buildReel();
    buildReelType();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
