---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Reveal from "../components/Reveal.astro";
import { getLang, ui } from "../i18n/ui";
import { formatYear } from "../lib/formatYear";
import { paletteAttrs } from "../lib/palette";
import { youtubeEmbed } from "../lib/youtube";
import { resolveGallery, type MediaEntry } from "../lib/media";

interface Props {
  title: string;
  subtitle: string;
  role: string;
  client: string;
  year: number;
  yearEnd?: number;
  ongoing?: boolean;
  tags: string[];
  cover?: string;
  gallery: MediaEntry[];
  video?: string;
}

const {
  title,
  subtitle,
  role,
  client,
  year,
  yearEnd,
  ongoing,
  tags,
  cover,
  gallery,
  video,
} = Astro.props;

const videoEmbed = video ? youtubeEmbed(video) : null;
const media = resolveGallery(gallery, title);

const lang = getLang(Astro.url.pathname);
const t = ui[lang].project;
---

<BaseLayout palette="about" title={title} description={subtitle}>
  <article>
    <header class="mx-auto max-w-3xl px-6 pt-12 lg:px-10 lg:pt-20">
      {/* Visual eyebrow only — the metadata list below exposes the same
          string with a proper "Role" label. */}
      <p class="reveal text-sm font-medium text-accent" aria-hidden="true">
        {role}
      </p>
      <Reveal as="h1" class="mt-3 font-display text-4xl font-bold leading-[1.05] lg:text-6xl">
        {title}
      </Reveal>
      <Reveal as="p" class="mt-6 max-w-xl text-lg text-ink-soft">{subtitle}</Reveal>
      <Reveal as="dl" class="mt-8 grid grid-cols-2 gap-6 border-t border-line pt-6 sm:grid-cols-4">
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink-soft">{t.role}</dt>
          <dd class="mt-1 font-medium">{role}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink-soft">{t.institution}</dt>
          <dd class="mt-1 font-medium">{client}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink-soft">{t.year}</dt>
          <dd class="mt-1 font-medium">{formatYear({ year, yearEnd, ongoing }, lang)}</dd>
        </div>
        {
          tags.length > 0 && (
            <div>
              <dt class="text-xs uppercase tracking-wide text-ink-soft">{t.tags}</dt>
              <dd class="mt-1 font-medium">{tags.join(" · ")}</dd>
            </div>
          )
        }
      </Reveal>
    </header>

    {
      cover && (
        <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-sm px-6 lg:px-10" data-ripple>
          <Image
            src={cover}
            width={1800}
            height={1100}
            alt={title}
            class="aspect-[16/10] w-full rounded-sm object-cover"
            widths={[800, 1200, 1600, 2000]}
            sizes="(max-width: 1024px) 100vw, 80vw"
          />
        </div>
      )
    }

    <div class="prose prose-project mx-auto max-w-3xl px-6 py-16 lg:px-10">
      <slot />
    </div>

    {
      videoEmbed && (
        <section class="mx-auto max-w-5xl px-6 pb-16 lg:px-10" {...paletteAttrs("about")}>
          <div class="video-frame" data-media>
            <iframe
              src={videoEmbed}
              title={title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          </div>
        </section>
      )
    }

    {
      media.length > 0 && (
        <div class="mx-auto grid max-w-6xl gap-6 px-6 pb-20 md:grid-cols-2 lg:px-10">
          {media.map(({ src, caption, alt }) => (
            <Reveal>
              <figure>
                <Image
                  src={src}
                  width={1200}
                  height={900}
                  alt={alt}
                  class="aspect-[4/3] w-full rounded-sm object-cover"
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
                {caption && <figcaption class="reel-caption">{caption}</figcaption>}
              </figure>
            </Reveal>
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .prose-project :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-project :global(p) {
    line-height: 1.9;
    color: var(--color-ink);
    margin-bottom: 1.25rem;
  }
</style>
