---
import { getCollection } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { stripLocale } from "../../i18n/ui";

export async function getStaticPaths() {
  const projects = (await getCollection("product-design"))
    .filter((e) => e.id.startsWith("he/"))
    .sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, index) => {
    const nextProject = projects[(index + 1) % projects.length];
    return {
      params: { slug: stripLocale(project.id) },
      props: {
        project,
        next:
          projects.length > 1
            ? {
                href: `/product-design/${stripLocale(nextProject.id)}`,
                title: nextProject.data.title,
                cover: nextProject.data.cover,
              }
            : null,
      },
    };
  });
}

const { project, next } = Astro.props;
---

<ProjectLayout
  title={project.data.title}
  subtitle={project.data.subtitle}
  role={project.data.role}
  client={project.data.client}
  year={project.data.year}
  yearEnd={project.data.yearEnd}
  ongoing={project.data.ongoing}
  tags={project.data.tags}
  cover={project.data.cover}
  gallery={project.data.gallery}
  video={project.data.video}
  coverAnimation={project.data.coverAnimation}
  animations={project.data.animations}
  links={project.data.links}
  body={project.body ?? ""}
  next={next}
/>
