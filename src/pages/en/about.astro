---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Reveal from "../../components/Reveal.astro";
import HoverDistortImage from "../../components/HoverDistortImage.astro";
---

<BaseLayout
  title="About"
  description="A little about me — Lital Bar Noy, UX Designer and Curator."
>
  <section class="mx-auto grid max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:px-10 lg:py-24">
    <div class="flex flex-col lg:min-h-[70vh] lg:justify-between">
      <Reveal as="h1" class="font-display text-6xl font-bold leading-[0.95] lg:text-8xl">
        About
      </Reveal>

      <div>
        <Reveal as="div" class="mt-10 space-y-5 text-lg leading-relaxed text-ink-soft lg:mt-0">
          <p>
            I'm Lital Bar Noy, a Senior Product Designer with extensive
            experience in cybersecurity, AI, and big data platforms. I
            specialize in transforming complex technical challenges into
            intuitive user experiences, with a proven track record at
            top-tier tech companies — Axonius, Microsoft, and Meta —
            combining deep strategic thinking with hands-on execution.
          </p>
          <p>
            Alongside product design, I also work in curation — I believe
            the space itself is part of the statement, not just a frame to
            hang work on. Both practices are, to me, the exact same craft:
            figuring out what actually matters to say, and arranging it so
            the person in front of me understands it without effort.
          </p>
          <p>Published author and lecturer on design theory and visual culture.</p>
        </Reveal>

        <Reveal as="div" class="mt-8 flex flex-wrap gap-6">
          <a
            href="mailto:litalbarnoy5@gmail.com"
            class="link-underline text-sm font-medium"
            data-cursor-hover
          >
            litalbarnoy5@gmail.com
          </a>
          <a
            href="https://www.linkedin.com/in/lital-bar-noy-49b96492/"
            target="_blank"
            rel="noopener"
            class="link-underline text-sm font-medium"
            data-cursor-hover
          >
            LinkedIn
          </a>
        </Reveal>
      </div>
    </div>

    <HoverDistortImage
      image1="/images/imports/about/portrait.webp"
      alt="Lital Bar Noy"
      class="aspect-[9/11] w-full rounded-sm lg:h-[70vh]"
    />
  </section>
</BaseLayout>
