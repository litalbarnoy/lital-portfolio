---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Reveal from "../../components/Reveal.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { formatYear } from "../../lib/formatYear";
import { stripLocale } from "../../i18n/ui";

const productDesign = (await getCollection("product-design"))
  .filter((e) => e.id.startsWith("en/"))
  .sort((a, b) => a.data.order - b.data.order);
const curatorial = (await getCollection("curatorial"))
  .filter((e) => e.id.startsWith("en/"))
  .sort((a, b) => a.data.order - b.data.order);

const featured = [
  { entry: productDesign[0], base: "product-design" },
  { entry: curatorial[0], base: "curatorial" },
].filter((f) => f.entry);

const pdPreviews = productDesign.map((p) => p.data.cover).join(",");
const curPreviews = curatorial.map((p) => p.data.cover).join(",");
---

<BaseLayout title="Home">
  <section class="mx-auto max-w-6xl px-6 pb-16 pt-20 lg:px-10 lg:pt-32">
    <div class="hero-lines overflow-hidden">
      <h1 class="font-display text-5xl font-bold leading-[1.1] lg:text-7xl">
        <span class="hero-line block"><span class="hero-line-inner block">Lital Bar Noy</span></span>
        <span class="hero-line block text-accent"><span class="hero-line-inner block">UX Design & Curatorial Work</span></span>
      </h1>
    </div>
    <p class="reveal mt-8 max-w-xl text-lg text-ink-soft">
      I design digital experiences and build exhibitions — two fields that
      both start with the same question: how do you help someone understand
      something new, without wasting a single word.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-6 pb-24 md:grid-cols-2 lg:px-10">
    <Reveal>
      <a
        href="/en/product-design"
        class="group relative block overflow-hidden rounded-sm border border-line p-10"
        data-cursor-hover
        data-preview-images={pdPreviews}
      >
        <div class="preview-bg absolute inset-[-4%] bg-cover bg-center opacity-0 transition-opacity duration-700"></div>
        <div class="absolute inset-0 bg-ink/0 transition-colors duration-700"></div>
        <div class="relative">
          <span class="text-sm font-medium text-accent transition-colors duration-500 preview-text">01</span>
          <h2 class="mt-4 text-3xl font-bold transition-colors duration-500 preview-text">Product Design</h2>
          <p class="mt-3 text-ink-soft transition-colors duration-500 preview-text">Research, prototyping, and testing — from problem to screen.</p>
          <span class="link-underline mt-6 inline-block text-sm font-medium transition-colors duration-500 preview-text">
            View all projects
          </span>
        </div>
      </a>
    </Reveal>
    <Reveal>
      <a
        href="/en/curatorial"
        class="group relative block overflow-hidden rounded-sm border border-line p-10"
        data-cursor-hover
        data-preview-images={curPreviews}
      >
        <div class="preview-bg absolute inset-[-4%] bg-cover bg-center opacity-0 transition-opacity duration-700"></div>
        <div class="absolute inset-0 bg-ink/0 transition-colors duration-700"></div>
        <div class="relative">
          <span class="text-sm font-medium text-accent transition-colors duration-500 preview-text">02</span>
          <h2 class="mt-4 text-3xl font-bold transition-colors duration-500 preview-text">Curatorial</h2>
          <p class="mt-3 text-ink-soft transition-colors duration-500 preview-text">Exhibitions and art projects I built from concept to wall.</p>
          <span class="link-underline mt-6 inline-block text-sm font-medium transition-colors duration-500 preview-text">
            View all projects
          </span>
        </div>
      </a>
    </Reveal>
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 pb-28 lg:px-10">
        <Reveal as="h2" class="text-2xl font-bold">
          Selected Work
        </Reveal>
        <div class="mt-8 grid gap-10 md:grid-cols-2">
          {featured.map(({ entry, base }) => (
            <ProjectCard
              href={`/en/${base}/${stripLocale(entry!.id)}`}
              title={entry!.data.title}
              subtitle={entry!.data.subtitle}
              cover={entry!.data.cover}
              year={formatYear(entry!.data, "en")}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import gsap from "gsap";

  function playHeroIntro() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const lines = document.querySelectorAll<HTMLElement>(".hero-line-inner");
    if (!lines.length) return;

    if (prefersReducedMotion) {
      lines.forEach((l) => (l.style.transform = "none"));
      return;
    }

    gsap.set(lines, { yPercent: 110 });
    gsap.to(lines, {
      yPercent: 0,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.1,
      delay: 0.1,
      // Leave no inline transform behind once the intro settles.
      clearProps: "transform",
    });
  }

  playHeroIntro();
  document.addEventListener("astro:page-load", playHeroIntro);

  function setupCategoryPreview() {
    document.querySelectorAll<HTMLElement>("[data-preview-images]").forEach((el) => {
      if (el.dataset.previewBound) return;
      el.dataset.previewBound = "true";

      const images = (el.dataset.previewImages || "").split(",").filter(Boolean);
      const bg = el.querySelector<HTMLElement>(".preview-bg");
      const overlay = el.querySelector<HTMLElement>(".preview-bg + div");
      if (!images.length || !bg) return;

      let index = 0;

      el.addEventListener("mouseenter", () => {
        bg.style.backgroundImage = `url(${images[index % images.length]})`;
        bg.style.opacity = "1";
        overlay?.classList.add("bg-ink/55");
        el.querySelectorAll<HTMLElement>(".preview-text").forEach((t) => {
          t.style.color = "var(--color-cream)";
        });
        index++;
      });

      el.addEventListener("mouseleave", () => {
        bg.style.opacity = "0";
        overlay?.classList.remove("bg-ink/55");
        el.querySelectorAll<HTMLElement>(".preview-text").forEach((t) => {
          t.style.color = "";
        });
      });
    });
  }

  setupCategoryPreview();
  document.addEventListener("astro:page-load", setupCategoryPreview);
</script>
