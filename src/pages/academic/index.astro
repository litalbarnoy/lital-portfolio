---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Reveal from "../../components/Reveal.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { stripLocale } from "../../i18n/ui";
import { publications } from "../../lib/publications";
import { paletteAttrs } from "../../lib/palette";

const entries = (await getCollection("academic"))
  .filter((e) => e.id.startsWith("he/"))
  .sort((a, b) => a.data.order - b.data.order);

const featured = entries;
const list = publications.he;
---

<BaseLayout palette="about"
  title="מחקר אקדמי"
  description="מחקר דוקטורט, פרסומים והרצאות מאת ליטל בר נוי."
>
  <section class="mx-auto max-w-6xl px-6 pt-16 lg:px-10 lg:pt-24" {...paletteAttrs("about")}>
    <Reveal as="h1" class="text-4xl font-bold lg:text-6xl">
      מחקר אקדמי
    </Reveal>
    <Reveal as="p" class="mt-4 max-w-xl text-lg text-ink-soft">
      מחקר הדוקטורט הנוכחי, לצד פרסומים והרצאות בנושאי תרבות חזותית ועיצוב.
    </Reveal>
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-16 lg:px-10" {...paletteAttrs("about")}>
        <div class="grid gap-10 md:grid-cols-2">
          {featured.map((entry) => (
            <ProjectCard
              href={`/academic/${stripLocale(entry.id)}`}
              title={entry.data.title}
              subtitle={entry.data.subtitle}
              cover={entry.data.cover!}
              year={entry.data.year}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    list.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 pb-24 lg:px-10" {...paletteAttrs("about")}>
        <Reveal as="h2" class="mb-6 text-sm font-medium uppercase tracking-wide text-ink-soft">
          פרסומים והרצאות
        </Reveal>
        <ul class="publication-list">
          {list.map((item) => (
            <li class="publication">
              <div>
                <p class="publication-title">{item.title}</p>
                <p class="publication-venue">{item.venue}</p>
              </div>
              <p class="publication-meta">
                {item.role} · {item.year}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
